---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.tsx';

const campaignData = [
  { throttle: 'TH0', ib: 0.51, mo: '6.827e10', gnp: '1.740e10', gr: '1.841e11', gnpLef: '3.92×', grLef: '0.37×' },
  { throttle: 'TH5', ib: 0.84, mo: '1.124e12', gnp: '2.657e11', gr: '1.988e12', gnpLef: '4.23×', grLef: '0.57×' },
  { throttle: 'TH10', ib: 1.10, mo: '4.435e12', gnp: '1.579e12', gr: '6.293e12', gnpLef: '2.81×', grLef: '0.70×' },
  { throttle: 'TH15', ib: 1.76, mo: '3.730e13', gnp: '2.679e13', gr: '4.404e13', gnpLef: '1.39×', grLef: '0.85×' }
];

const fnData = [
  { mat: 'Mo', phi: 4.6, lam: 100, k: 2.0, onset: '7.27 MV/m', pbd: 0.15 },
  { mat: 'Graphene', phi: 4.5, lam: 150, k: 1.8, onset: '4.01 MV/m', pbd: 0.44 },
  { mat: 'GNP', phi: 4.5, lam: 200, k: 1.5, onset: '2.26 MV/m', pbd: 0.58 }
];
---

<BaseLayout title="Data & Results — VIOT Research">
  <section class="py-16 md:py-24">
    <Reveal>
      <p class="kicker mb-4">Results</p>
      <h1 class="heading-academic text-5xl md:text-6xl leading-tight">
        Data &amp; Findings
      </h1>
      <p class="text-academic mt-6 text-xl max-w-3xl">
        Primary campaign results, EBS lifetime analysis, and Fowler-Nordheim breakdown risk assessment.
      </p>
    </Reveal>
  </section>

  <!-- Campaign -->
  <section class="py-16 border-t border-edge">
    <Reveal>
      <h2 class="heading-academic text-3xl mb-4">Comparative Erosion Campaign</h2>
      <p class="text-academic mb-8 max-w-4xl">
        36 runs = 3 materials × 4 throttles × 3 seeds. N=1e5, stride 10, DX=10 µm, 5,000 steps. GNP benefit peaks at TH5 and decays monotonically to TH15.
      </p>
    </Reveal>
    <Reveal delay={100}>
      <div class="overflow-x-auto rounded-lg border border-edge">
        <table class="table-academic">
          <thead>
            <tr>
              <th>Throttle</th>
              <th>I_b (A)</th>
              <th>Mo (atoms)</th>
              <th>GNP (atoms)</th>
              <th>Graphene (atoms)</th>
              <th class="text-navy">GNP LEF</th>
              <th class="text-accent">Graphene LEF</th>
            </tr>
          </thead>
          <tbody>
            {campaignData.map(row => (
              <tr>
                <td class="font-mono">{row.throttle}</td>
                <td class="font-mono">{row.ib}</td>
                <td class="font-mono">{row.mo}</td>
                <td class="font-mono">{row.gnp}</td>
                <td class="font-mono">{row.gr}</td>
                <td class="font-bold text-navy">{row.gnpLef}</td>
                <td class="font-bold text-accent">{row.grLef}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Reveal>
  </section>

  <!-- FN Risk -->
  <section class="py-16 border-t border-edge">
    <Reveal>
      <h2 class="heading-academic text-3xl mb-4">Fowler–Nordheim Breakdown Risk</h2>
      <p class="text-academic mb-8 max-w-4xl">
        GNP's edge-rich morphology drops measurable breakdown onset from ~7.3 to ~2.3 MV/m — <strong>potentially design-limiting</strong>.
      </p>
    </Reveal>
    <Reveal delay={100}>
      <div class="overflow-x-auto rounded-lg border border-edge">
        <table class="table-academic">
          <thead>
            <tr>
              <th>Material</th>
              <th>φ (eV)</th>
              <th>Weibull λ</th>
              <th>Weibull k</th>
              <th class="text-destructive">Onset (P>1e−4)</th>
              <th>P_BD @ 15 MV/m</th>
            </tr>
          </thead>
          <tbody>
            {fnData.map(row => (
              <tr>
                <td class="font-bold">{row.mat}</td>
                <td class="font-mono">{row.phi}</td>
                <td class="font-mono">{row.lam}</td>
                <td class="font-mono">{row.k}</td>
                <td class="font-bold text-destructive">{row.onset}</td>
                <td class="font-mono">{row.pbd}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Reveal>
  </section>
</BaseLayout>
