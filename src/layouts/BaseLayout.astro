---
import '../styles/global.css';
const { title, description = 'VIOT — Virtual Ion-Optics Testbed Research' } = Astro.props;
const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: base, label: 'Overview' },
  { href: `${base}methods/`, label: 'Methods' },
  { href: `${base}data/`, label: 'Data & Results' },
  { href: `${base}about/`, label: 'People' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">VIOT Research</a>
      <div class="nav-links">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </div>
  </nav>
  <main class="container" style="padding-top:3rem;padding-bottom:4rem;">
    <slot />
  </main>
  <footer class="footer">
    <div class="footer-inner">
      <span>© 2026 VIOT Research Program.</span>
      <span class="footer-right">Data is open</span>
    </div>
  </footer>
</body>
</html>
