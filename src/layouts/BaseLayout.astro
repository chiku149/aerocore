---
import '../styles/global.css';
const { title, description = 'VIOT — Virtual Ion-Optics Testbed Research', page = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#F4F4F0" />
  <title>{title}</title>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  <nav class="nav" aria-label="Site navigation">
    <div class="nav-inner">
      <a href={base} class="nav-logo" aria-label="VIOT Research — home">VIOT</a>
      <div class="nav-links">
        <a href={base} aria-current={page === 'home' ? 'page' : undefined}>Overview</a>
        <a href={`${base}methods/`} aria-current={page === 'methods' ? 'page' : undefined}>Methods</a>
        <a href={`${base}data/`} aria-current={page === 'data' ? 'page' : undefined}>Data &amp; Results</a>
        <a href={`${base}about/`} aria-current={page === 'about' ? 'page' : undefined}>People</a>
      </div>
      <span class="nav-badge">Open Research</span>
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <span class="footer-logo">VIOT Research</span>
      <span class="footer-copy">© 2026 Shantanu Pawar — PVG's COETM Pune</span>
      <span class="footer-open">Data is Open</span>
    </div>
  </footer>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { TextPlugin } from 'gsap/TextPlugin';

    gsap.registerPlugin(ScrollTrigger, TextPlugin);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      document.querySelectorAll('[data-gsap]').forEach(el => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
      document.querySelectorAll('.char').forEach(el => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    } else {
      window.__gsap = gsap;
      window.__ST = ScrollTrigger;
      // Fail-safe: if GSAP freezes or errors out, ensure opacity becomes 1 after a short delay
      setTimeout(() => {
        document.querySelectorAll('.char').forEach(el => {
          if ((el as HTMLElement).style.opacity === '0') {
             (el as HTMLElement).style.opacity = '1';
             (el as HTMLElement).style.transform = 'none';
          }
        });
      }, 2000);
    }
  </script>
</body>
</html>
